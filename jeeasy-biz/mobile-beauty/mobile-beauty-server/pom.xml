    <version>${revision}</version>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>mobile-beauty-server</artifactId>

    <properties>
        <application.main.class>org.jeeasy.biz.mobile.MobileBeautyApplication</application.main.class>
        <server-name>mobile-beauty</server-name>
    </properties>

    <!-- 依赖管理 -->
    <dependencies>
        <!-- 模块引用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>mobie.alps</groupId>
            <artifactId>mobile-beauty-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>mobie.alps</groupId>
            <artifactId>jeeasy-system-api</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>cloud</id>
            <dependencies>
                <dependency>
                    <groupId>mobie.alps</groupId>
                    <artifactId>jeeasy-cloud-base</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <!-- 构建工具 -->
    <build>
        <plugins>
            <!-- 选择性地启用父级模块中的插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
